# Android fstab for DEXP Ursus B38 (SC7731E)
# <src>                                  <mnt_point>     <type>  <mnt_flags>             <fs_mgr_flags>

# Основные разделы
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/boot      /boot       emmc    defaults    defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/recovery  /recovery   emmc    defaults    defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/system    /system     ext4    ro,barrier=1    wait
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vendor    /vendor     ext4    ro,barrier=1    wait
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata  /data       f2fs    noatime,nosuid,nodev,discard,inline_xattr,inline_data    wait,check,encryptable=footer
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/cache     /cache      ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc    wait,check

# Внешняя SD-карта (если нужна в recovery)
/dev/block/mmcblk1p1  /external_sd  vfat    defaults    defaults

# USB-OTG (если поддерживается)
/dev/block/sda1       /usb_otg      vfat    defaults    defaults

# Для работы шифрования (если используется)
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/misc      /misc       emmc    defaults    defaults
